---
import Sheet from "../layouts/Sheet.astro";
import { REVS } from "../data/revs.js";
import { PRESS, SENRA, CAREERS, EMAIL, ROLES } from "../data/site.js";
const newestFirst = [...REVS].reverse();
---
<Sheet description="Co-founder of Senra, where we build harnesses for aerospace and defense companies. I focus on AI and robotics for precision assembly." sheet="1" dwg="BS-001">
  <section class="hero">
    <div class="hero__text reveal is-in">
      <h1 class="sr-only">Benjamin Shanahan</h1>
      <p class="intro">Hi, I'm Ben. I co-founded <a href={SENRA} target="_blank" rel="noreferrer">Senra</a>, where we build harnesses for aerospace and defense companies.</p>
      <p class="lede">Before Senra I wrote manufacturing software at SpaceX. Before that I studied neuroscience at Brown and worked on brain-computer interfaces.</p>
    </div>

    <aside class="hire reveal is-in" aria-label="Hiring">
      <p class="hire__tag mono"><span class="sq" aria-hidden="true"></span>ECN 0001 &nbsp; Open roles</p>
      <p>I'm hiring engineers to build Senra's robotics program from the ground up. The problems come straight from our factory floor, and you'll build alongside the technicians who use your work. These roles are in Cypress, CA, and report to me.</p>
      {ROLES.length > 0 && (
        <ul class="hire__roles">
          {ROLES.map(([title, href]) => <li><a class="ext" href={href} target="_blank" rel="noreferrer">{title}</a></li>)}
        </ul>
      )}
      <div class="actions mono">
        <a class="btn btn--hl ext" href={CAREERS} target="_blank" rel="noreferrer">Come build with me</a>
        <a class="btn ext" href={`mailto:${EMAIL}`}>Email me</a>
      </div>
    </aside>

    <!-- revision list on the left, Fig. 1 on the right; the list scrolls within the figure's height -->
    <div class="trace">
      <section class="trace__list" aria-labelledby="revs">
        <h2 id="revs" class="sr-only">Revision history</h2>
        <div class="trace__scroll">
          <table class="table">
            <thead><tr><th>Rev</th><th>Revisions</th></tr></thead>
            <tbody>
              {newestFirst.map((r) => (
                <tr class={r.now ? "is-current" : undefined} data-rev={r.rev}>
                  <td class="rev"><button class="rev-toggle" type="button" aria-label={`Highlight revision ${r.rev}: ${r.title}`} aria-pressed="false" disabled>{r.rev}</button></td>
                  <td>
                    <span class="t-date mono">{r.date}</span>
                    <span class="t-title">{r.title} {r.tag && <span class={r.now ? "tag tag--hl" : "tag"}>{r.tag}</span>}</span>
                    <Fragment set:html={r.desc} />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <figure class="figure">
        <div id="brain" data-revs={JSON.stringify(REVS)}></div>
        <figcaption class="mono">
          <span>Fig. 1 &nbsp; Human-machine interface assy</span>
          <span>Not to scale</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="block reveal" aria-labelledby="about">
    <div class="head"><h2 id="about">About</h2><span class="mono">Notes</span></div>
    <div class="about">
      <div class="prose">
        <p>I built my first website in 2005, when I was ten. Around the same time, a LEGO Mindstorms kit gave me my first taste of robotics. In early high school at Boston Latin, my dad got me an Arduino kit, and I started teaching myself electronics: soldering, reading schematics and building circuits.</p>
        <p>I love art and making music as much as hardware. Some of my favorite projects bring those interests together, like <a href="/projects/audiolux/">Audiolux</a>, a light show that reacts to music in real time. At Brown, I studied neuroscience and got into brain-computer interfaces, where hardware, software and the brain all came together. I graduated magna cum laude in 2017, with honors in neuroscience, and spent the next year in the BrainGate lab building a real-time monitoring system for the research cart.</p>
        <p>From there I went to NeuroPace, building tools that brought research to doctors, then to SpaceX, working on Warpdrive and manufacturing software in the Starlink factory. In 2023, Jordan Black and I started <a href="https://senrasystems.us" target="_blank" rel="noreferrer">Senra</a> to fix the wire harness problems we kept running into at SpaceX. I spent our first three years building Amp with the team. Now I'm focused on robotics and AI for the technicians in our factory.</p>
        <p>I love understanding how things work and sticking with hard problems until the pieces click. Outside work, I tend to pick one activity and go deep for a year or so, whether that's climbing, volleyball, running, hiking or biking. I also make time for <a href="/projects/">hobby projects</a> and enjoy cooking when I'm not in a rush.</p>
      </div>
      <figure class="portrait">
        <div class="portrait__img">
          <img src="/img/ben-portrait.jpg" alt="Benjamin Shanahan" width="866" height="1294" />
          <i class="crop crop--tl"></i><i class="crop crop--tr"></i><i class="crop crop--bl"></i><i class="crop crop--br"></i>
        </div>
        <figcaption class="mono"><span>Fig. 2</span><span>B. Shanahan</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="block reveal" aria-labelledby="press">
    <div class="head"><h2 id="press">Reference documents</h2></div>
    <table class="table">
      <thead><tr><th>Ref</th><th>Article</th><th class="hide-sm">Source</th></tr></thead>
      <tbody>
        {PRESS.map(([title, href, source], i) => (
          <tr><td class="rev">R{i + 1}</td><td><a class="t-title ext" href={href} target="_blank" rel="noreferrer">{title}</a></td><td class="date hide-sm">{source}</td></tr>
        ))}
      </tbody>
    </table>
  </section>
</Sheet>

<script>
  import { buildBrain } from "../scripts/brain.js";
  const host = document.getElementById("brain");
  if (host) buildBrain(host, JSON.parse(host.dataset.revs));
</script>
